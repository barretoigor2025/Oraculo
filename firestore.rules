rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Coleções legadas do Oráculo. Mantidas sem alteração.
    match /rooms/{id} {
      allow read, write: if true;
    }
    match /lobbies/{id} {
      allow read, write: if true;
    }
    match /sessoes/{sessaoId} {
      allow read, write: if true;
    }

    // Espaços próprios do Mind RolePlay.
    match /mindCampaigns/{campaignId} {
      allow read, write: if true;
    }
    match /mindRooms/{roomId} {
      allow read, write: if true;
    }
  }
}
